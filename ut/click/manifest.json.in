{
    "name": "@NAME@",
    "title": "Dolphin",
    "description": "GameCube and Wii emulator. Unofficial Ubuntu Touch port of Dolphin (https://dolphin-emu.org), not supported by the Dolphin team. Source: @SOURCE@",
    "version": "@VERSION@",
    "architecture": "arm64",
    "framework": "ubuntu-touch-24.04-2.x",
    "maintainer": "@MAINTAINER@",
    "hooks": {
        "dolphin-ut": {
            "apparmor": "dolphin-ut.apparmor",
            "desktop": "dolphin-ut.desktop",
            "content-hub": "dolphin-ut-content.json"
        }
    }
}
